# Copy to .env and fill in. Grown by later tickets (see backlog.md §4.4). Documented in docs/env.md.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nudel
# Production/preview on Neon only: direct (non-pooled) URL used by `prisma migrate deploy`.
# DATABASE_URL_UNPOOLED=
# Used only by `pnpm db:seed` (admin@example.com). Choose a strong value outside local dev.
SEED_ADMIN_PASSWORD=change-me-local-only
# Optional: email of the seeded admin (default admin@example.com). Use a real address on production.
# SEED_ADMIN_EMAIL=
# Set to false on production: skips the 4 demo drivers (they share a well-known PIN).
# SEED_DRIVERS=false
# Optional, exactly 6 digits; PIN of the 4 seeded driver accounts (default 123456, dev only).
# SEED_DRIVER_PIN=123456
# Auth.js session signing key (required). Generate: openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32-output
# Object storage (S3-compatible: MinIO locally, Cloudflare R2 in production). Without these the
# app uses an in-memory Fake in dev/test (uploads are not persisted) and fails in production.
# Local MinIO from docker-compose.yml:
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nudel-photos
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Geocoding AND routing via OpenRouteService (https://openrouteservice.org, free API key; one key for both).
# Without a key the app uses a deterministic Fake geocoder (fake coordinates around Vienna) and the local
# routing heuristic (estimated distances, results flagged approximate), and logs one warning for each.
# ORS_API_KEY=
# Optional: ORS routing profile, driving-car (default) or driving-hgv (truck).
# ORS_ROUTING_PROFILE=driving-car
# Optional: countries the geocoder searches in (ISO 3166-1 alpha-2, comma separated). Default AT,DE.
# ORS_GEOCODE_COUNTRIES=AT,DE
# Optional: pause between two geocoder calls of the customer import's batch geocoding (ms, 0..10000).
# Default 700 with ORS_API_KEY (ORS free tier: about 100 requests/minute, 1000/day), 0 for the Fake.
# GEOCODE_BATCH_DELAY_MS=700
# Map tiles (Leaflet). Default: OpenStreetMap standard tiles, DEVELOPMENT ONLY (OSM tile usage policy).
# Production needs a provider with a usage plan (e.g. MapTiler / Stadia free tier); use that provider's
# attribution text (HTML allowed).
# MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# MAP_TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
# Optional, default OFF (NUD-108): 1 = the driver app's service worker keeps the map tiles the driver
# has looked at (max. 300, 7 days; never a bulk download) so they show again in a dead spot. Needs an
# explicit MAP_TILE_URL, is read at BUILD time (service worker) and at start time, and the provider's
# terms must allow caching (docs/env.md). Without it the offline map shows stops and route on a plain background.
# MAP_TILE_CACHE=1
# Optional: how often the admin dashboard and a released tour page re-read the live progress (ms,
# 1000..300000, default 30000). Only e2e tests use a shorter value.
# LIVE_POLL_INTERVAL_MS=30000
# Machine translation of notes and driver texts (https://www.deepl.com/pro-api). Without a key the app uses
# a Fake translator (texts get a visible "[zh-Hans]" / "[de]" prefix, nothing is really translated) and logs one warning.
# DEEPL_API_KEY=
# Optional: free or pro endpoint (api-free.deepl.com / api.deepl.com). Default: free when the key ends in ":fx", else pro.
# DEEPL_API_PLAN=free
# Secret for the Vercel cron jobs (GET /api/cron/retry-translations every 10 min, GET /api/cron/retention and /api/cron/audit-retention daily).
# Vercel sends it as "Authorization: Bearer <secret>". Without it the route rejects every request. Generate: openssl rand -base64 32
# CRON_SECRET=
# Order screenshots are deleted after this many days by the daily retention cron (GET /api/cron/retention, needs CRON_SECRET). 1..3650, default 180.
# SCREENSHOT_RETENTION_DAYS=180
# Audit log entries are deleted after this many days by the daily GET /api/cron/audit-retention (needs CRON_SECRET). 90..36500, default 730; invalid or lower values fall back to 730.
# AUDIT_RETENTION_DAYS=730
# Send the Content-Security-Policy as report-only (violations are logged, nothing is blocked). Default: enforcing.
# CSP_REPORT_ONLY=true


# --- Monitoring, backups, operations (NUD-094) ---
# Sentry error reporting (server + browser). Optional: without a valid DSN nothing is loaded or sent.
# Read when the app is BUILT (browser) and started (server): redeploy after changing it. The DSN host is
# added to the CSP connect-src automatically. Details: docs/deploy.md "Sentry", docs/runbook.md.
# SENTRY_DSN=https://<public key>@o<org>.ingest.de.sentry.io/<project id>
# Source maps are uploaded at build time ONLY when all four of SENTRY_DSN, SENTRY_AUTH_TOKEN, SENTRY_ORG and
# SENTRY_PROJECT are set (Vercel build environment; the token is a secret).
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# Optional labels in Sentry; defaults: VERCEL_ENV / NODE_ENV and the git commit of the deployment.
# SENTRY_ENVIRONMENT=
# SENTRY_RELEASE=
# Test only: enables the hidden pages /admin/dev/error and /driver/dev-error that raise an error on purpose
# (e2e run, or a deliberate check on staging). NEVER in production (the build refuses it).
# ENABLE_ERROR_TEST_PAGES=true
# Weekly orphaned-object cleanup (GET /api/cron/orphan-cleanup, needs CRON_SECRET): off | dry-run (default, only
# reports) | delete. Grace period in days, 7..365, default 14.
# ORPHAN_CLEANUP_MODE=dry-run
# ORPHAN_CLEANUP_GRACE_DAYS=14
# Weekly database backup (pnpm backup:db, GitHub Action .github/workflows/backup.yml). In GitHub these are
# secrets of the environment "backup"; locally only for tests. A DIRECT (unpooled) read-only connection and a
# bucket + token that are separate from the photo bucket.
# BACKUP_DATABASE_URL=postgresql://backup_reader:...@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# BACKUP_S3_ENDPOINT=https://<account id>.eu.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=nudel-backups
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_REGION=auto
# BACKUP_PREFIX=db/
# BACKUP_RETENTION_WEEKS=8
# Empty scratch database for the test restore (pnpm backup:verify). Never production.
# RESTORE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restore_check
# pnpm admin:reset-password: --email on the command line or ADMIN_EMAIL; the password is typed at a hidden prompt,
# piped on stdin or (least safe) ADMIN_NEW_PASSWORD. Uses DATABASE_URL_UNPOOLED / DATABASE_URL.
# ADMIN_EMAIL=
# ADMIN_NEW_PASSWORD=
