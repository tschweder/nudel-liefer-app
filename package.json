{
  "name": "nudel-liefer-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && tsx scripts/build-pwa.ts",
    "build:vercel": "tsx scripts/check-deploy-env.ts && prisma migrate deploy && next build && tsx scripts/build-pwa.ts",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit && tsc -p src/sw/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "i18n:build": "tsx scripts/i18n-build.ts",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "i18n:export": "tsx scripts/i18n-export.ts",
    "i18n:import": "tsx scripts/i18n-import.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:customers": "tsx scripts/seed-test-customers.ts",
    "db:embedded": "tsx scripts/embedded-postgres.ts",
    "pwa:icons": "tsx scripts/generate-pwa-icons.ts",
    "backup:db": "tsx scripts/backup/pg-backup.ts",
    "backup:verify": "tsx scripts/backup/restore-verify.ts",
    "admin:reset-password": "tsx scripts/admin-reset-password.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/nextjs": "11.8.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "leaflet": "1.9.4",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "opencc-js": "^1.4.2",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "react-leaflet": "5.0.0",
    "serwist": "9.5.13",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@serwist/build": "9.5.13",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.8",
    "embedded-postgres": "16.14.0-beta.17",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "intl-messageformat": "^12.1.3",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  }
}
