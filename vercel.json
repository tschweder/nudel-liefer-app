{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["fra1"],
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build:vercel",
  "crons": [
    {
      "path": "/api/cron/retry-translations",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "17 3 * * *"
    }
  ]
}
