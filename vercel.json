{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["fra1"],
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build:vercel",
  "crons": [
    {
      "path": "/api/cron/retry-translations",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "17 3 * * *"
    },
    {
      "path": "/api/cron/audit-retention",
      "schedule": "37 3 * * *"
    },
    {
      "path": "/api/cron/data-retention",
      "schedule": "47 3 * * *"
    },
    {
      "path": "/api/cron/recurring-orders",
      "schedule": "27 2 * * *"
    },
    {
      "path": "/api/cron/orphan-cleanup",
      "schedule": "7 4 * * 0"
    }
  ]
}
