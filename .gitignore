# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local
.env
.env.*
!.env.example
playwright-report/
test-results/

# generated / local
/src/generated
/.embedded-postgres

# parking-spot import (docs/parking-import): the raw 2026-10 captures are client data (photos of
# shops and parking spots, ~400 MB) and the work directory holds derived crops and review results.
# Neither is committed; the scripts, the review report and its template are.
/2026-10/
/.parking-import/

# review CSV exports (real review output, never commit)
/i18n-review*.csv

# message fragments of the translation workflow (per-batch JSON, merged into messages/*.json;
# scratch input, not part of the app)
/messages/_fragments/

# local pnpm content store: created by a bare `corepack prepare pnpm@...` and a full package tree,
# so it must never be committed and must not be linted
/.pnpm-store/

# generated by scripts/build-pwa.ts after `next build` (NUD-080)
/public/sw.js
/public/offline.js
/public/offline.html

# generated by scripts/build-hand-off.ts after `next build` (NUD-127): the source of truth is
# content/hand-off/index.ts, so a hand-edit of the HTML is always lost on the next build.
/public/hand-off.html
/public/hand-off.css
/public/hand-off.js
/public/hand-off-data.js

# Lighthouse CI (NUD-095): profile and reports
/.lighthouseci

# script hashes of the prerendered pages for the CSP, written by scripts/csp-script-hashes.ts (NUD-110)
/.csp-script-hashes.json
