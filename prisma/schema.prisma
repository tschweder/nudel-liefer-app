// Core v1 schema (backlog §6). AuditLog is added by NUD-092.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DRIVER
}

/// Mapped to BCP-47 tags in the database; see src/lib/localized-text.ts.
enum Locale {
  de
  en
  sr_Latn @map("sr-Latn")
  cs
  zh_Hans @map("zh-Hans")
}

enum Unit {
  KG
  PACK
  CRATE
  PIECE
}

enum PhotoKind {
  STORE
  PARKING
}

enum OrderSource {
  MANUAL
  SCREENSHOT
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum TourStatus {
  DRAFT
  OPTIMIZED
  RELEASED
  IN_PROGRESS
  COMPLETED
}

/// What a re-release did to a stop (NUD-043): shown to the driver as a highlight.
enum StopChange {
  ADDED
  CHANGED
}

enum StopStatus {
  PENDING
  DELIVERED
  PROBLEM
}

enum ProblemReason {
  CLOSED
  NOBODY_THERE
  NO_PARKING
  WRONG_QUANTITY
  REFUSED
  ADDRESS_NOT_FOUND
  OTHER
}

model User {
  id           String    @id @default(cuid())
  role         Role
  email        String?   @unique
  username     String?   @unique
  passwordHash String
  locale       Locale    @default(de)
  localeChosen Boolean   @default(false)
  displayName  String
  active       Boolean   @default(true)
  /// Set on every successful login (NUD-008).
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  photos      Photo[]
  screenshots Screenshot[]
  orders      Order[]
  tours       Tour[]

  parkingSpots ParkingSpot[]
}

/// Singleton row (id = 1).
model Settings {
  id                    Int     @id @default(1)
  depotName             String
  depotAddress          String
  depotLat              Float
  depotLng              Float
  /// True once an admin has confirmed the depot pin on the map (D9). Tour building requires it.
  depotPinConfirmed     Boolean @default(false)
  timezone              String  @default("Europe/Vienna")
  departureTime         String  @default("07:00")
  serviceMinutesPerStop Int     @default(10)
  deliveryWeekdays      Int[]   @default([1, 2, 3, 4, 5])
}

model Customer {
  id                String   @id @default(cuid())
  customerNumber    String   @unique
  name              String
  street            String
  postalCode        String
  city              String
  country           String   @default("AT")
  lat               Float?
  lng               Float?
  pinConfirmed      Boolean  @default(false)
  /// LocalizedText
  notes             Json?
  deliveryHoursInfo String?
  /// Legal entity behind the shop ("Firma"), office only. The driver matches `name` to the signage.
  companyName       String?
  /// VAT identification number ("UID", e.g. ATU12345678), office only.
  vatId             String?
  /// Billing address, only when it differs from the delivery address above (office only, never routed).
  billingStreet     String?
  billingPostalCode String?
  billingCity       String?
  active            Boolean  @default(true)
  /// Accent-folded number/name/address for search. Maintained by a DB trigger (migration NUD-013); never write it.
  searchText        String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  photos       Photo[]
  orders       Order[]
  stops        Stop[]
  parkingSpots ParkingSpot[]

  @@index([name])
}

/// Where the driver parks and unloads at a customer (NUD-125, D22). A customer has a list; the first
/// active one by `sortOrder` is the default and becomes the routing / navigation point (NUD-141).
/// Soft delete only (`active=false`).
model ParkingSpot {
  id          String   @id @default(cuid())
  customerId  String
  /// Short name shown to the office and the driver ("Hof", "Gasse hinten"); optional.
  label       String?
  /// Free text typed by the office or a driver (docs/privacy.md section 6); optional.
  note        String?
  lat         Float
  lng         Float
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([customerId, active, sortOrder])
}

model Photo {
  id               String    @id @default(cuid())
  customerId       String
  kind             PhotoKind
  storageKey       String
  width            Int
  height           Int
  bytes            Int
  uploadedById     String
  isCurrent        Boolean   @default(true)
  createdAt        DateTime  @default(now())
  /// Client-generated id of a driver capture (NUD-083): a retry of the same capture finds this row
  /// instead of creating a second photo. `null` for photos added by the office.
  clientMutationId String?   @unique

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  uploadedBy User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([customerId, kind, isCurrent])
}

model Product {
  id              String   @id @default(cuid())
  sku             String   @unique
  /// LocalizedText
  name            Json
  unit            Unit
  /// Weight of one unit in kilograms (NUD-138): Beutel 3, Karton 10, Wantan-Teig 5. Admin-editable,
  /// always > 0 (CHECK constraint in the migration); the tour weight (NUD-146) is computed from it.
  weightKgPerUnit Decimal  @db.Decimal(6, 2)
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orderItems OrderItem[]
}

model Screenshot {
  id           String   @id @default(cuid())
  storageKey   String
  uploadedById String
  createdAt    DateTime @default(now())
  /// Filled by AI extraction in M3.
  extraction   Json?

  uploadedBy User    @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  orders     Order[]
}

model Order {
  id           String      @id @default(cuid())
  customerId   String
  deliveryDate DateTime    @db.Date
  status       OrderStatus @default(DRAFT)
  source       OrderSource @default(MANUAL)
  screenshotId String?
  internalNote String?
  createdById  String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  screenshot Screenshot? @relation(fields: [screenshotId], references: [id], onDelete: SetNull)
  createdBy  User        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items      OrderItem[]
  stopOrders StopOrder[]

  @@index([deliveryDate, status])
  @@index([customerId, deliveryDate])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  /// Whole number of units (D23, NUD-137): Beutel, Karton or pieces; never a fraction.
  quantity  Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

/// No unique constraint on date: several tours per date are allowed later (D5).
model Tour {
  id              String     @id @default(cuid())
  date            DateTime   @db.Date
  driverId        String?
  status          TourStatus @default(DRAFT)
  isOutdated      Boolean    @default(false)
  locked          Boolean    @default(false)
  depotSnapshot   Json
  geometry        Json?
  totalDistanceM  Int?
  totalDurationS  Int?
  /// True when the route came from the local heuristic (estimated distances, straight-line geometry).
  approximate     Boolean    @default(false)
  /// 0 = never released, 1 = first release, +1 for every re-release that changed something (NUD-043).
  releaseRevision Int        @default(0)
  /// When the last re-release happened (null = never re-released); the driver app shows "Tour was updated".
  reReleasedAt    DateTime?
  /// What the last re-release changed (`TourDiff` plus `revision`, `at`, names for removed stops); null before.
  lastChange      Json?
  optimizedAt     DateTime?
  releasedAt      DateTime?
  completedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  driver User?  @relation(fields: [driverId], references: [id], onDelete: Restrict)
  stops  Stop[]

  @@index([date])
}

model Stop {
  id                String         @id @default(cuid())
  tourId            String
  customerId        String
  sequence          Int
  status            StopStatus     @default(PENDING)
  etaAt             DateTime?
  legDistanceM      Int?
  legDurationS      Int?
  problemReason     ProblemReason?
  /// LocalizedText (source = driver locale)
  problemNote       Json?
  completedAt       DateTime?
  clientMutationId  String?        @unique
  /// Quantities the office released for this stop, `[{productId, quantity}]` (NUD-043). The driver
  /// sees this snapshot, never the live order lines, so an order edited after release shows up only via re-release.
  items             Json           @default("[]")
  /// Quantities before the last re-release that changed this stop (null otherwise).
  previousItems     Json?
  changeKind        StopChange?
  /// `Tour.releaseRevision` in which `changeKind` was set; the driver highlights revisions it has not seen yet.
  changedInRevision Int?
  /// When the office last changed this stop's content (a re-release that changed or added it, NUD-082).
  /// The offline sync lets this win over a driver mutation that was made earlier on the phone.
  adminChangedAt    DateTime?

  tour      Tour           @relation(fields: [tourId], references: [id], onDelete: Cascade)
  customer  Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orders    StopOrder[]
  mutations StopMutation[]

  @@index([tourId, sequence])
  @@index([customerId])
}

/// Driver stop-status mutation log (NUD-053): one row per accepted client mutation, keyed by the
/// client-generated id. A replay of the same id returns `result` without a second state change.
model StopMutation {
  id        String           @id
  stopId    String
  driverId  String
  kind      StopMutationKind
  result    Json
  createdAt DateTime         @default(now())

  stop Stop @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@index([stopId])
}

enum StopMutationKind {
  COMPLETE
  UNDO
}

model StopOrder {
  stopId  String
  orderId String

  stop  Stop  @relation(fields: [stopId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@id([stopId, orderId])
  @@index([orderId])
}

/// Failed login attempts, used for rate limiting (NUD-004). Rows older than the window are pruned.
model LoginAttempt {
  id        String   @id @default(cuid())
  /// "user:<admin|driver>:<identifier>" or "ip:<address>"
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// Append-only history of changes to orders, tours, stops and customer photos (NUD-092). Rows are
/// written by `recordAudit` in the service layer, inside the transaction of the change itself,
/// and are never updated or deleted (the database refuses it, see the migration).
/// `entity` is "Order" | "Tour" | "Stop" | "Customer", `action` a dotted name such as
/// "order.update"; both are plain strings so a new action never needs a migration.
/// `diff` holds ids and values only (no names, no secrets); readers resolve names.
/// `actorId` is deliberately not a foreign key: users are archived, never deleted (backlog 4.3), and the
/// history must outlive whatever happens to the user row.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  entity    String
  entityId  String
  action    String
  diff      Json
  createdAt DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@index([createdAt])
}
